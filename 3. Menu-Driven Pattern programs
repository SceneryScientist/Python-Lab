n = int(input(‘Enter limit: ‘)) 
while True: 
  print() 
  menu = int(input(‘ 1. Diamond\n 2. Hourglass\n 3. Alphabet pyramid\n 4. Exit\n Enter:‘)) 
   
  if menu==1: 
    for i in range(n): 
      for j in range(n-i): 
      print (‘ ‘, end=‘ ‘) 
      for j in range(i): 
      print (‘*’, end=‘ ‘) 
      for j in range(i-1): 
      print (‘*’, end=‘ ‘) 
      print() 
   
    for i in range(n): 
      for j in range(i+2): 
      print (‘ ‘, end=‘ ‘) 
      for j in range(n-i-2): 
      print (‘*’, end=‘ ‘) 
      for j in range(n-i-3): 
      print (‘*’, end=‘ ‘) 
      print() 
