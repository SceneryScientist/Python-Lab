x = int(input(‘Number 1: ‘)) 
y = int(input(‘Number 2: ‘)) 
big = 0 
small = 0 
hcf = 0 
lcm = 0 
 
if x>y: 
  big = x 
  small = y 
elif x<y: 
  big = y 
  small = x 
else: 
  print(‘Equal’) 
 
for i in range(1, small+1): 
  if small%i==0 and big%i==0: 
    hcf = i 
    print (‘HCF =‘,hcf) 
     
lcm = (x*y)//hcf 
print(‘LCM =‘,lcm) 
