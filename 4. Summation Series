#a) 1 + x + x² + x³ + x⁴ + ... + x^n
x = int(input(‘Enter value of x: ‘)) 
n = int(input(‘Enter value of n: ‘)) 
temp = 0 
sum = 0 
 
for i in range(0,n+1): 
    temp = x**i 
    sum = sum + temp 
    i = i+1 
     
print (sum) 

#b) 1 - x + x² - x³ + x⁴ - ... x^n 
x = int(input(‘Enter value of x: ‘)) 
n = int(input(‘Enter value of n: ‘)) 
temp = 0 
sum = 0 
 
for i in range(0,n+1): 
    temp = x**i 
    sum = sum + ((-1)**i)*temp 
    i = i+1 
 
print(sum) 

#c)x+x^2/2+x^3/3+...+x^n/n
