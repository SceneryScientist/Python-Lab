x = int(input(‘Enter a number: ‘)) 
sum = 0 
 
for i in range(1, x): 
  if x%i == 0: 
  sum = sum+i 
 
if sum == x: 
  print (‘The number is a perfect number.’) 
 
arm = x 
length = len (str (arm)) 
sum = 0 
while arm != 0: 
  r = arm % 10 
  sum = sum + (r**length) 
  arm = arm//10 
 
if x == sum: 
  print (‘The number is an Armstrong number.’) 
 
y = str(x)[::-1] 
if str (x) == y: 
  print (‘The given number is a palindrome.’) 
