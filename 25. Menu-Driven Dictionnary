    print (json.dumps(d, indent=2)) 
   
  elif menu==2: 
    mvalue = max(d.values()) 
    for i in d: 
      if d[i]==mvalue: 
        break 
    print (‘Maximum value:’, {i:mvalue}) 

  elif menu==3: 
    dnew = {} 
    for i in d: 
      key = i 
      if d[i] not in dnew.values(): 
        dnew[i] = d[i] 
     
    print (json.dumps(dnew, indent=2)) 
     
  elif menu==4: 
    lsort = sorted(d.items()) 
    print (‘Sorted dictionary:’, json.dumps(d, indent=2)) 
   
  elif menu==5: 
